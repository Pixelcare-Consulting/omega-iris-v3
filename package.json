    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.25",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.3",
    "bytes-formatter": "^21.6.15",
    "class-variance-authority": "^0.7.1",
    "clipboard-polyfill": "^4.1.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "flydrive": "^2.1.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.4.0",
    "next": "16.2.11",
