{
  "name": "LIS",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "pnpm prettier --write .",
    "db:push": "pnpm prisma db push && pnpm prisma generate",
    "db:pull": "pnpm prisma db pull",
    "db:generate": "pnpm prisma generate",
    "db:reset": "pnpm prisma db push --force-reset",
    "db:studio": "pnpm prisma studio --browser none --port 5555",
    "db:seed": "pnpm db:reset && tsx --tsconfig tsconfig.json prisma/seed.ts && pnpm db:seed:sap-database && pnpm db:seed:role-sap-database",
    "db:seed:sap-database": "tsx --tsconfig tsconfig.json prisma/seed-sap-database.ts",
    "db:seed:role-sap-database": "tsx --tsconfig tsconfig.json prisma/seed-role-sap-database.ts",
    "db:validate": "pnpm prisma validate",
    "files:migrate": "tsx --tsconfig tsconfig.json scripts/migrate-file-attachments.ts",
    "sap:smoke": "tsx --tsconfig tsconfig.json --conditions react-server scripts/sap-smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@casl/ability": "6.4.0",
