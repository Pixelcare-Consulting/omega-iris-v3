# copy to .env and fill in.
# DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL and the SAP_* account are required, the rest fall back to the
# values shown here. See README.md for what each one does.

# db
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database>?schema=public"

# auth
BETTER_AUTH_SECRET="<random-32+-char-string>"
BETTER_AUTH_URL="http://localhost:3000"

# app settings
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_NODE_ENV="development"
NEXT_PUBLIC_DISABLE_REPORTING="false"
SIGNIN_MAXIMUM_ATTEMPTS=5

# storage
STORAGE_PATH="../omega-iris-v3-storage"
FILE_STORAGE_DISK="fs"

# sap, one shared service account, only CompanyDB changes per database
SAP_BASE_URL="https://<sap-host>:50000"
SAP_USERNAME="<service-account>"
SAP_PASSWORD="<service-account-password>"
SAP_TLS_REJECT_UNAUTHORIZED="false"
SYNC_LOOKBACK_DAYS=2